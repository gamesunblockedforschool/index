<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Games for School</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

:root{
    --bg:#f5f5f5;
    --card:#ffffff;
    --text:#111;
    --accent:#4f46e5;
    --border:#dddddd;
}

body.dark{
    --bg:#111827;
    --card:#1f2937;
    --text:#f3f4f6;
    --border:#374151;
}

body{
    background:var(--bg);
    color:var(--text);
    transition:.25s;
}

header{
    max-width:1100px;
    margin:auto;
    padding:30px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

h1{
    font-size:30px;
}

button{
    cursor:pointer;
    border:none;
}

#themeBtn{
    background:var(--card);
    color:var(--text);
    border:1px solid var(--border);
    padding:10px 14px;
    border-radius:8px;
}

.container{
    max-width:1100px;
    margin:auto;
    padding:20px;
}

.search{
    width:100%;
    padding:14px;
    border:1px solid var(--border);
    background:var(--card);
    color:var(--text);
    border-radius:10px;
    font-size:16px;
    outline:none;
}

.filters{
    margin:20px 0;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.filter{
    background:var(--card);
    border:1px solid var(--border);
    color:var(--text);
    padding:10px 14px;
    border-radius:999px;
}

.filter.active{
    background:var(--accent);
    color:white;
    border-color:var(--accent);
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:14px;
    overflow:hidden;
    transition:.2s;
}

.card:hover{
    transform:translateY(-3px);
}

.thumb{
    height:120px;
    background:linear-gradient(135deg,#6366f1,#8b5cf6);
}

.content{
    padding:16px;
}

.content h3{
    margin-bottom:8px;
}

.tag{
    display:inline-block;
    margin-top:10px;
    font-size:12px;
    background:rgba(79,70,229,.12);
    color:var(--accent);
    padding:5px 10px;
    border-radius:999px;
}

.play{
    margin-top:14px;
    width:100%;
    padding:10px;
    background:var(--accent);
    color:white;
    border-radius:8px;
}

footer{
    text-align:center;
    padding:40px 20px;
    color:gray;
}
</style>
</head>
<body>

<header>
    <h1>Games for School</h1>
    <button id="themeBtn">🌙</button>
</header>

<div class="container">

<input class="search" id="search" placeholder="Search games...">

<div class="filters">
    <button class="filter active" data-filter="All">All</button>
    <button class="filter" data-filter="Puzzle">Puzzle</button>
    <button class="filter" data-filter="Arcade">Arcade</button>
    <button class="filter" data-filter="Strategy">Strategy</button>
</div>

<div class="grid" id="grid"></div>

</div>

<footer>
This is a sample game directory template. Add your own games or links where appropriate.
</footer>

<script>
const games=[
{
title:"2048",
category:"Puzzle",
description:"Merge tiles to reach 2048."
},
{
title:"Chess",
category:"Strategy",
description:"Classic board game."
},
{
title:"Snake",
category:"Arcade",
description:"Collect food and grow."
},
{
title:"Minesweeper",
category:"Puzzle",
description:"Find all safe tiles."
},
{
title:"Tic Tac Toe",
category:"Strategy",
description:"Simple two-player game."
},
{
title:"Breakout",
category:"Arcade",
description:"Break every brick."
}
];

const grid=document.getElementById("grid");
const search=document.getElementById("search");
const filters=document.querySelectorAll(".filter");

let current="All";

function render(){

const text=search.value.toLowerCase();

grid.innerHTML="";

games
.filter(game=>{
const matchSearch=game.title.toLowerCase().includes(text);
const matchCategory=current==="All"||game.category===current;
return matchSearch&&matchCategory;
})
.forEach(game=>{

const card=document.createElement("div");
card.className="card";

card.innerHTML=`
<div class="thumb"></div>
<div class="content">
<h3>${game.title}</h3>
<p>${game.description}</p>
<div class="tag">${game.category}</div>
<button class="play">Play</button>
</div>
`;

grid.appendChild(card);

});

}

search.addEventListener("input",render);

filters.forEach(btn=>{
btn.onclick=()=>{
filters.forEach(b=>b.classList.remove("active"));
btn.classList.add("active");
current=btn.dataset.filter;
render();
};
});

document.getElementById("themeBtn").onclick=()=>{
document.body.classList.toggle("dark");
};

render();
</script>

</body>
</html>
